      {
        "id": "CarePlan",
        "path": "CarePlan"
      },
      {
        "id": "CarePlan.status",
        "path": "CarePlan.status",
        "min": 1,
        "mustSupport": true
      },
      {
        "id": "CarePlan.intent",
        "path": "CarePlan.intent",
        "min": 1,
        "mustSupport": true,
        "fixedCode": "plan"
      },
      {
        "id": "CarePlan.category",
        "path": "CarePlan.category",
        "mustSupport": true
      },
      {
